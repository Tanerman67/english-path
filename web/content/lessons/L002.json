  "grammar": {
    "topic": "Present Perfect vs Past Simple",
    "explanationRu": "Present Perfect связывает прошлое с настоящим результатом (I have finished). Past Simple часто указывает на завершённое время (I finished it yesterday).",
    "examples": [
      "I have already checked the logs.",
      "I checked the logs yesterday."
    ]
  },
